#!/usr/bin/env bash
# journal-hook — PostToolUse hook that logs tool calls to a session journal.
# Appends one JSONL line per tool invocation. Designed to be fast and silent —
# never blocks, never fails loudly.
#
# Input (stdin): JSON with session_id, tool_name, tool_input
# Output (stdout): empty (PostToolUse hooks don't gate execution)
set +e  # Never exit on error — must not disrupt the session

INPUT=$(cat)

# Skip tools that generate noise without signal
TOOL=$(printf '%s' "$INPUT" | grep -o '"tool_name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*:[[:space:]]*"//;s/"$//')
case "$TOOL" in
  Glob|Grep|Read|TaskGet|TaskList|TaskOutput|TaskUpdate|ToolSearch)
    # Read-only / bookkeeping tools — skip
    exit 0
    ;;
esac

JOURNAL_DIR="$HOME/.gstack/sessions"
mkdir -p "$JOURNAL_DIR" 2>/dev/null || exit 0

# Session ID for grouping — use Claude's session ID if available, else PID
SESSION_ID=$(printf '%s' "$INPUT" | grep -o '"session_id"[[:space:]]*:[[:space:]]*"[^"]*"' | head -1 | sed 's/.*:[[:space:]]*"//;s/"$//')
[ -z "$SESSION_ID" ] && SESSION_ID="$$"

DATE=$(date -u +%Y-%m-%d)
JOURNAL="$JOURNAL_DIR/${DATE}.jsonl"

# Extract key fields from tool_input depending on tool type
FILE_PATH=""
COMMAND=""
SKILL=""
DESCRIPTION=""

case "$TOOL" in
  Edit|Write)
    FILE_PATH=$(printf '%s' "$INPUT" | python3 -c 'import sys,json; print(json.loads(sys.stdin.read()).get("tool_input",{}).get("file_path",""))' 2>/dev/null || true)
    ;;
  Bash)
    COMMAND=$(printf '%s' "$INPUT" | python3 -c 'import sys,json; c=json.loads(sys.stdin.read()).get("tool_input",{}).get("command",""); print(c[:200])' 2>/dev/null || true)
    DESCRIPTION=$(printf '%s' "$INPUT" | python3 -c 'import sys,json; print(json.loads(sys.stdin.read()).get("tool_input",{}).get("description",""))' 2>/dev/null || true)
    ;;
  Skill)
    SKILL=$(printf '%s' "$INPUT" | python3 -c 'import sys,json; print(json.loads(sys.stdin.read()).get("tool_input",{}).get("skill",""))' 2>/dev/null || true)
    ;;
  Agent)
    DESCRIPTION=$(printf '%s' "$INPUT" | python3 -c 'import sys,json; print(json.loads(sys.stdin.read()).get("tool_input",{}).get("description",""))' 2>/dev/null || true)
    ;;
esac

# Build the journal entry — compact, one line
REPO=$(basename "$(git rev-parse --show-toplevel 2>/dev/null)" 2>/dev/null || basename "$(pwd)")
BRANCH=$(git branch --show-current 2>/dev/null || echo "unknown")
TS=$(date -u +%Y-%m-%dT%H:%M:%SZ)

# Construct JSON manually to avoid jq dependency
ENTRY="{\"ts\":\"$TS\",\"session\":\"$SESSION_ID\",\"repo\":\"$REPO\",\"branch\":\"$BRANCH\",\"tool\":\"$TOOL\""
[ -n "$FILE_PATH" ] && ENTRY="$ENTRY,\"file\":\"$FILE_PATH\""
[ -n "$COMMAND" ] && ENTRY="$ENTRY,\"cmd\":\"$(printf '%s' "$COMMAND" | sed 's/"/\\"/g' | head -c 200)\""
[ -n "$SKILL" ] && ENTRY="$ENTRY,\"skill\":\"$SKILL\""
[ -n "$DESCRIPTION" ] && ENTRY="$ENTRY,\"desc\":\"$(printf '%s' "$DESCRIPTION" | sed 's/"/\\"/g' | head -c 200)\""
ENTRY="$ENTRY}"

echo "$ENTRY" >> "$JOURNAL" 2>/dev/null

exit 0
